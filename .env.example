# Base URL of the Django REST API, no trailing slash.
# Local development: http://localhost:8000/api
# Production: the Render-hosted API URL
API_BASE_URL=http://localhost:8000/api

# Port the Node SSR server binds to.
# Render assigns this automatically in production — set only for local `node dist/.../server.mjs` runs.
PORT=4200

# Comma-separated list of hostnames the SSR server accepts requests for.
# @angular/ssr returns 400 for any Host/X-Forwarded-Host not in this list.
# Local development: localhost
# Production: the deployed domain, e.g. restaurant-directory.onrender.com
ALLOWED_HOSTS=localhost
