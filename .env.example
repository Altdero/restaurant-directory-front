# Base URL of the Django REST API, no trailing slash.
# Local development: http://localhost:8000/api
# Production: the Render-hosted API URL
API_BASE_URL=http://localhost:8000/api

# Absolute origin of this app itself, no trailing slash — used for canonical
# URLs, hreflang alternates, JSON-LD and sitemap.xml. Not knowable at build
# time in general (Render assigns the domain), so it must be set explicitly.
# Local development: http://localhost:4200
# Production: the deployed domain, e.g. https://restaurant-directory.onrender.com
SITE_URL=http://localhost:4200

# Port the Node SSR server binds to.
# Render assigns this automatically in production — set only for local `node dist/.../server.mjs` runs.
PORT=4200

# Comma-separated list of hostnames the SSR server accepts requests for.
# @angular/ssr returns 400 for any Host/X-Forwarded-Host not in this list.
# Local development: localhost
# Production: the deployed domain, e.g. restaurant-directory.onrender.com
ALLOWED_HOSTS=localhost

# Credentials for a real, already-registered account on the backend at
# API_BASE_URL — only used by `npm run e2e:live` (e2e/specs/live-smoke.spec.ts).
# Not needed for `npm test` or `npm run e2e` (mocked). Never a throwaway value
# committed anywhere; `live-smoke.spec.ts` skips itself with a clear reason
# when these are unset.
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=
